# ─────────────────────────────────────────────
# Shelfmark — .gitignore
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
**/node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# ── Build & compile outputs ───────────────────
dist/
build/
*.dist
out/

# ── Environment / secrets ─────────────────────
.env
.env.*
!.env.example

# ── IDE & editor config ───────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# ── OS junk ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime / process ─────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Test coverage ─────────────────────────────
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
vitest-snapshots/

# ── TypeScript ────────────────────────────────
*.tsbuildinfo

# ── Cache dirs ────────────────────────────────
.cache/
.parcel-cache/
.vite/
**/.vite/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.turbo/

# ── Package manager artifacts ─────────────────
.npm/
.yarn-integrity
*.tgz
# Keep pnpm-lock.yaml — ignore npm/yarn locks
package-lock.json
yarn.lock

# ── PWA / Workbox generated files ─────────────
sw.js
workbox-*.js

# ── Database files ────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Platform / Manus artifacts ────────────────
client/public/__manus__/
.project-config.json
.manus-logs/
.webdev/

# ── Sentry ────────────────────────────────────
.sentryclirc

# ── Framework-specific ────────────────────────
.next/
.nuxt/
.out/
.storybook-out/

# ── Scratch / personal notes (not for repo) ───
security.md
todo.md
todo-rail.md
todo-features.md
ideas.md
template.json

# ── Temp ──────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
